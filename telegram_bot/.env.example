# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Service Keys (Gemini for Vision + NLP, Groq for ultra-fast text NLP)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin Configuration
# Option 1: Path to Firebase Service Account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Raw Firebase Service Account JSON string (for Cloud / Vercel / Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Optional: Default user ID if you want to lock the bot to a single user without /link
# DEFAULT_USER_ID=your_firebase_auth_user_id
